# Copy to .env (or run `scoreboard init`). Never commit the result.

# Devin API. A service-user API key or personal access token; SSO governs webapp
# login, not API calls.
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_BASE_URL=https://api.devin.ai

# GitHub. Read access to every intake repository; write access only to the fork.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Shared secret for GitHub webhook deliveries. With this unset the webhook
# endpoint rejects every request.
WEBHOOK_SECRET=

SCOPE_PATH=scope.yaml
POLICY_PATH=policy.yaml
DB_PATH=data/facts.db

# Route and record, but create no Devin sessions. Deliberately the default.
DRY_RUN=true

# Permit pull requests against an upstream intake repository. Leave false.
ALLOW_UPSTREAM_WRITE=false
