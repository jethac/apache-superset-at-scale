# Keep credentials, local state and build noise out of the build context, so
# they cannot end up in an image layer even by accident.
.env
.env.*
!.env.example
*.pem
*.key
.git
.github
.venv
venv
data
*.db
*.sqlite3
__pycache__
*.py[cod]
.mypy_cache
.pytest_cache
.ruff_cache
dist
build
*.egg-info
docs
tests
